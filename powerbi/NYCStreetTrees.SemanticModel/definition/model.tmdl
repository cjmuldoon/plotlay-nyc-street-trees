model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["DataFolder","GetFile","Neighbourhoods","TreesByCensus","Census","Species","EastNewYork"]

ref table Neighbourhoods
ref table TreesByCensus
ref table Census
ref table Species
ref table EastNewYork

ref cultureInfo en-US
