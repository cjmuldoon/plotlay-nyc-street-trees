	partition Neighbourhoods = m
		mode: import
		source =
				let
				    Source = Csv.Document(GetFile("tables/change_1995_2015.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"nta", "name", "borough", "area_km2", "trees_1995", "trees_2005", "trees_2015", "change", "change_pct"}),
				    Typed = Table.TransformColumnTypes(Kept, {{"nta", type text}, {"name", type text}, {"borough", type text}, {"area_km2", type number}, {"trees_1995", Int64.Type}, {"trees_2005", Int64.Type}, {"trees_2015", Int64.Type}, {"change", Int64.Type}, {"change_pct", type number}}, "en-US"),
				    ShortNames_name_short = [#"Annadale-Huguenot-Prince's Bay-Eltingville" = "Annadale-Huguenot-Prince's Bay", #"Breezy Point-Belle Harbor-Rockaway Park-Broad Channel" = "Breezy Point-Belle Harbor", #"Carroll Gardens-Columbia Street-Red Hook" = "Carroll Gardens-Columbia Street", #"Charleston-Richmond Valley-Tottenville" = "Charleston-Richmond Valley", #"DUMBO-Vinegar Hill-Downtown Brooklyn-Boerum Hill" = "DUMBO-Vinegar Hill", #"Douglas Manor-Douglaston-Little Neck" = "Douglas Manor-Douglaston", #"Georgetown-Marine Park-Bergen Beach-Mill Basin" = "Georgetown-Marine Park", #"Hudson Yards-Chelsea-Flatiron-Union Square" = "Hudson Yards-Chelsea-Flatiron", #"Hunters Point-Sunnyside-West Maspeth" = "Hunters Point-Sunnyside", #"Mariner's Harbor-Arlington-Port Ivory-Graniteville" = "Mariner's Harbor-Arlington-Port Ivory", #"Queensbridge-Ravenswood-Long Island City" = "Queensbridge-Ravenswood", #"Schuylerville-Throgs Neck-Edgewater Park" = "Schuylerville-Throgs Neck", #"Sheepshead Bay-Gerritsen Beach-Manhattan Beach" = "Sheepshead Bay-Gerritsen Beach", #"Soundview-Castle Hill-Clason Point-Harding Park" = "Soundview-Castle Hill-Clason Point", #"Todt Hill-Emerson Hill-Heartland Village-Lighthouse Hill" = "Todt Hill-Emerson Hill", #"Van Nest-Morris Park-Westchester Square" = "Van Nest-Morris Park", #"West New Brighton-New Brighton-St. George" = "West New Brighton-New Brighton"],
				    Short_name_short = Table.AddColumn(Typed, "name_short", each Record.FieldOrDefault(ShortNames_name_short, [name], [name]), type text)
				in
				    Short_name_short

	annotation PBI_ResultType = Table
