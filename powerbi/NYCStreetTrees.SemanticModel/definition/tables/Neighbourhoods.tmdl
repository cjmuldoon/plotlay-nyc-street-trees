table Neighbourhoods
	lineageTag: 1fa782fa-b1f5-41d7-d1d6-77fd3c262a9a

	/// The census the tree measures use: the one picked, or 2015 when none is
	measure 'Census shown' = SELECTEDVALUE ( Census[census], 2015 )
		formatString: 0
		lineageTag: 431cc4b3-e63d-659f-3ff1-f9ea53ab489a

	/// Live street trees in the census shown
	measure Trees =
			VAR y = [Census shown]
			RETURN CALCULATE ( SUM ( TreesByCensus[trees] ), TreesByCensus[census] = y )
		formatString: #,0
		lineageTag: 25230b5d-5455-e7a7-c324-638c0e00013e

	/// Live street trees per km² of the neighbourhoods in view, census shown
	measure 'Trees per km2' =
			VAR y = [Census shown]
			RETURN DIVIDE ( CALCULATE ( SUM ( TreesByCensus[trees] ), TreesByCensus[census] = y ), SUM ( Neighbourhoods[area_km2] ) )
		formatString: #,0
		lineageTag: f35404cd-fd4a-3377-7f03-45f6b2e8647f

	/// Live street trees, 2015 less 1995
	measure 'Change since 1995' = SUM ( Neighbourhoods[trees_2015] ) - SUM ( Neighbourhoods[trees_1995] )
		formatString: #,0
		lineageTag: 35774d87-2412-b3d3-bd8d-c18405ae4e0a

	/// As change_pct in Plotlay, for the neighbourhoods in view
	measure 'Change since 1995 pct' = DIVIDE ( SUM ( Neighbourhoods[trees_2015] ) - SUM ( Neighbourhoods[trees_1995] ), SUM ( Neighbourhoods[trees_1995] ) )
		formatString: 0.0%
		lineageTag: 60ca5372-ba5a-ae12-c511-6f9988d48231

