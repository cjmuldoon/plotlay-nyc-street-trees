table TreesByCensus
	lineageTag: ea9f266c-fa28-4c2a-bc5b-409dd608b84a

	column nta
		dataType: string
		isHidden
		lineageTag: 47a090ca-14d7-7125-d68a-8a58def5d2ec
		summarizeBy: none
		sourceColumn: nta

		annotation SummarizationSetBy = Automatic

	column census
		dataType: int64
		formatString: 0
		isHidden
		lineageTag: 8fcf3ce0-ccd7-79b8-f320-9a8cb02cb999
		summarizeBy: none
		sourceColumn: census

		annotation SummarizationSetBy = Automatic

	column trees
		dataType: int64
		formatString: #,0
		lineageTag: 771ad80b-9eae-c53e-c9a3-192985bdfd2d
		summarizeBy: none
		sourceColumn: trees

		annotation SummarizationSetBy = Automatic

	column trees_per_km2
		dataType: double
		formatString: #,0
		lineageTag: 89e0b027-bfe8-a90e-9e9e-d6c3eee85795
		summarizeBy: none
		sourceColumn: trees_per_km2

		annotation SummarizationSetBy = Automatic

	partition TreesByCensus = m
		mode: import
		source =
				let
				    Source = Csv.Document(GetFile("tables/trees_by_census.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"nta", "census", "trees", "trees_per_km2"}),
				    Typed = Table.TransformColumnTypes(Kept, {{"nta", type text}, {"census", Int64.Type}, {"trees", Int64.Type}, {"trees_per_km2", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
