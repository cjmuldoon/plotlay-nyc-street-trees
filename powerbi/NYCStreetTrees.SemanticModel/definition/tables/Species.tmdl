table Species
	lineageTag: e1520b59-97a5-32c7-889f-6e8883920ab8

	/// Share of live street trees, census on the legend
	measure 'Share of trees' = SUM ( Species[share] ) / 100
		formatString: 0.0%
		lineageTag: f4966580-079b-bc77-1582-ac29e1d14049

	column species
		dataType: string
		lineageTag: 76cf0257-a7c3-4ba0-e967-0c252925a689
		summarizeBy: none
		sourceColumn: species

		annotation SummarizationSetBy = Automatic

	column census
		dataType: int64
		formatString: 0
		lineageTag: dae7e8b1-ecb8-672a-1ce4-56543d77acb0
		summarizeBy: none
		sourceColumn: census

		annotation SummarizationSetBy = Automatic

	column share
		dataType: double
		formatString: 0.0
		lineageTag: 8dc8d4e4-0296-53fe-ed54-6f1b893c7fe8
		summarizeBy: none
		sourceColumn: share

		annotation SummarizationSetBy = Automatic

	partition Species = m
		mode: import
		source =
				let
				    Source = Csv.Document(GetFile("tables/species.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"species", "share_1995", "share_2005", "share_2015"}),
				    Typed = Table.TransformColumnTypes(Kept, {{"species", type text}, {"share_1995", type number}, {"share_2005", type number}, {"share_2015", type number}}, "en-US"),
				    Long = Table.UnpivotOtherColumns(Typed, {"species"}, "col", "share"),
				    Yr = Table.AddColumn(Long, "census", each Number.FromText(Text.End([col], 4)), Int64.Type),
				    Out = Table.SelectColumns(Yr, {"species", "census", "share"})
				in
				    Out

	annotation PBI_ResultType = Table
