table EastNewYork
	lineageTag: 245d0062-8d0c-2443-cd48-67af16852dc2

	measure 'Tree count' = COUNTROWS ( EastNewYork )
		formatString: #,0
		lineageTag: f376f583-9b85-78d3-7d38-fc30a1655fa8

	column id
		dataType: string
		lineageTag: a401d633-9f9f-f9be-21a7-8e2718e1fdf7
		summarizeBy: none
		sourceColumn: id

		annotation SummarizationSetBy = Automatic

	column census
		dataType: int64
		formatString: 0
		lineageTag: e70b97dd-cba2-72d3-beb2-45d5338d949a
		summarizeBy: none
		sourceColumn: census

		annotation SummarizationSetBy = Automatic

	column lat
		dataType: double
		lineageTag: 3d003d53-5e75-618a-ca5f-c78c6979d7df
		summarizeBy: none
		sourceColumn: lat
		dataCategory: Latitude

		annotation SummarizationSetBy = Automatic

	column lng
		dataType: double
		lineageTag: 05207570-8182-79c2-ee2a-f02cfeae454e
		summarizeBy: none
		sourceColumn: lng
		dataCategory: Longitude

		annotation SummarizationSetBy = Automatic

	column species
		dataType: string
		lineageTag: 15f5f4ab-94ef-7080-fa0d-a0c140ee4bb4
		summarizeBy: none
		sourceColumn: species

		annotation SummarizationSetBy = Automatic

	column dbh_in
		dataType: double
		formatString: 0
		lineageTag: 2ff5aef3-0cf2-231e-d3f7-38463a018440
		summarizeBy: none
		sourceColumn: dbh_in

		annotation SummarizationSetBy = Automatic

	column nta
		dataType: string
		lineageTag: 9d46b83c-9ce5-ce13-b700-4012fa376632
		summarizeBy: none
		sourceColumn: nta

		annotation SummarizationSetBy = Automatic

	column tree
		dataType: string
		lineageTag: f03c09b7-b6f5-b8cd-da08-72221f7d4109
		summarizeBy: none
		sourceColumn: tree

		annotation SummarizationSetBy = Automatic

	partition EastNewYork = m
		mode: import
		source =
				let
				    Source = Csv.Document(GetFile("trees/east_new_york_trees.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"id", "census", "lat", "lng", "species", "dbh_in", "nta"}),
				    Typed = Table.TransformColumnTypes(Kept, {{"id", type text}, {"census", Int64.Type}, {"lat", type number}, {"lng", type number}, {"species", type text}, {"dbh_in", type number}, {"nta", type text}}, "en-US"),
				    Keyed = Table.AddColumn(Typed, "tree", each Text.From([census]) & "-" & [id], type text)
				in
				    Keyed

	annotation PBI_ResultType = Table
